{
  "name": "leaderboard-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "compact": "compact compile leaderboard.compact managed/leaderboard",
    "compile:pool": "compact compile pool.compact managed/pool",
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -Rf ./managed ./dist/managed",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@openzeppelin/compact-contracts": "0.3.0-rc.1"
  },
  "license": "Apache-2.0"
}
